# Development only: where `npm run dev` proxies /api (the OPC UA gateway). Default http://localhost:5000
# VITE_GATEWAY_URL=http://localhost:5000

# Only when this app is hosted on a different origin than the gateway (then also add this app's origin
# to the gateway's Hosting:CorsOrigins). Leave unset when the gateway serves the build.
# VITE_API_BASE_URL=
